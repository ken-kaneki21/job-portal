# ==================================================
# Job Intelligence
# Example local environment configuration
# ==================================================

# Copy this file to:
#
#   .env
#
# Then fill in only the credentials/integrations you use.
# Never commit real secrets.


# --------------------------------------------------
# PostgreSQL - local host access
# --------------------------------------------------

DATABASE_URL=postgresql+psycopg://jobintel:jobintel_dev@localhost:55432/jobintel

JOBINTEL_POSTGRES_DB=jobintel
JOBINTEL_POSTGRES_USER=jobintel
JOBINTEL_POSTGRES_PASSWORD=jobintel_dev

# Used by containers when connecting to Postgres
JOBINTEL_DOCKER_DATABASE_URL=postgresql+psycopg://jobintel:jobintel_dev@postgres:5432/jobintel


# --------------------------------------------------
# Temporal
# --------------------------------------------------

# Local Python processes
JOBINTEL_TEMPORAL_ADDRESS=localhost:7233

# Dockerized API / worker
JOBINTEL_TEMPORAL_ADDRESS_DOCKER=temporal:7233

JOBINTEL_TEMPORAL_NAMESPACE=default
JOBINTEL_TEMPORAL_TASK_QUEUE=job-intelligence-pipeline

TEMPORAL_POSTGRES_DB=temporal
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal

TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000


# --------------------------------------------------
# API
# --------------------------------------------------

JOBINTEL_API_HOST=0.0.0.0
JOBINTEL_API_PORT=8000


# --------------------------------------------------
# Observability
# --------------------------------------------------

JOBINTEL_WORKER_METRICS_PORT=9101

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=jobintel_dev


# --------------------------------------------------
# Job discovery APIs
# --------------------------------------------------

# Adzuna
# Create your own credentials and place them only in .env.

ADZUNA_APP_ID=
ADZUNA_APP_KEY=


# --------------------------------------------------
# LLM providers
# --------------------------------------------------

# Optional depending on configured enrichment / generation provider.

OPENAI_API_KEY=
GROQ_API_KEY=


# --------------------------------------------------
# Email notifications - Resend
# --------------------------------------------------

# Required only when Resend notifications are enabled.

RESEND_API_KEY=

NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
